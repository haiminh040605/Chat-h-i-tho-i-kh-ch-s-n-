# ==========================================
# OPENAI API CONFIGURATION
# ==========================================
# Điền khóa bí mật OpenAI API của bạn (bắt đầu bằng sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Model OpenAI muốn sử dụng (Mặc định: gpt-4o-mini tốc độ cao, tiết kiệm chi phí)
OPENAI_MODEL=gpt-4o-mini

